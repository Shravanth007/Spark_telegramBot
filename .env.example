# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_USER=your_github_username_here
GITHUB_DEFAULT_REPO=your_github_username/your_default_repo  # optional

# Google OAuth (for Gmail)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Your deployed Vercel URL (no trailing slash)
BOT_BASE_URL=https://your-app.vercel.app

# Upstash Redis / Vercel KV
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# Optional: restrict bot to specific Telegram chat IDs (comma-separated)
# Leave empty to allow anyone to use the bot
ALLOWED_CHAT_IDS=
